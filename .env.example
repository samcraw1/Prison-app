# Copy to .env.local. Values marked server-only must never be NEXT_PUBLIC_ or shipped to the apps.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_NAME=SecureVisit
NEXT_PUBLIC_DEFAULT_FACILITY=demo-county
# server-only (optional; video visits show "not set up" without it)
DAILY_API_KEY=
# Payments (docs/PAYMENTS.md). Test mode keys only until launch. Server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional public origin used in Stripe return URLs (defaults to the request origin)
PUBLIC_APP_URL=

# Secret for the daily jobs (account erasure, AI data retention) (Vercel cron sends it as a Bearer token). Required in production.
CRON_SECRET=

# AI features (v1.1, docs/AI.md). server-only. All off per facility until an admin turns them on.
# Vercel AI Gateway key (on Vercel deployments OIDC can be used instead). Leave empty to disable AI entirely.
AI_GATEWAY_API_KEY=
# Exact gateway model id, confirmed by the owner from the gateway model list. No default on purpose.
AI_MODEL=anthropic/claude-haiku-5.5
# Translation and staff review assist send message text to the model. Set to true ONLY after confirming zero data
# retention with both the gateway and the model provider (docs/AI.md). The help bot never sends message text.
AI_ALLOW_MESSAGE_CONTENT=false

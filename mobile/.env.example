# Public values only. Never put the Supabase service-role key, Daily API key or push secret here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Origin of the SecureVisit web app (Next.js). Simulator: http://localhost:3000. Device on LAN: http://<your-mac-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEFAULT_FACILITY=demo-county
# Payments (see docs/PAYMENTS.md). OFF by default: with EXPO_PUBLIC_PAYMENTS_ENABLED unset, the balance, add-funds and
# fee screens are hidden. Only set it to "true" in a build that App Review has been told about.
EXPO_PUBLIC_PAYMENTS_ENABLED=
# Also required when payments are on:
# "us" shows an "Add funds" button that opens Stripe Checkout in the system browser. Only for builds distributed
# where the store allows it, after counsel signs off.
EXPO_PUBLIC_IOS_EXTERNAL_PURCHASE_LINK=
EXPO_PUBLIC_ANDROID_EXTERNAL_PURCHASE_LINK=
